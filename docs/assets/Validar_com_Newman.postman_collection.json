  "item": [
    {
      "name": "Validar cadastro de Categoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Status code 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Name não vazio\", function () {",
              "    pm.expect(jsonData.data.name).to.be.a('string').and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Description não vazia\", function () {",
              "    pm.expect(jsonData.data.description).to.be.a('string').and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"is_active = true\", function () {",
              "    pm.expect(jsonData.data.is_active).to.be.true;",
              "});",
              "",
              "pm.test(\"Mensagem \\\"Categoria criada com sucesso!\\\"\", function () {",
              "    pm.expect(jsonData.mensagens).to.include(\"Categoria criada com sucesso!\");",
              "});",
              "",
              "pm.test(\"Response tem estrutura correta\", function () {",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData).to.have.property('mensagens');",
              "});",
              "",
              "pm.test(\"data.id é um número válido\", function () {",
              "    pm.expect(jsonData.data.id).to.be.a('number').and.to.be.above(0);",
              "});",
              "",
              "pm.test(\"data.slug não é vazio\", function () {",
              "    pm.expect(jsonData.data.slug).to.be.a('string').and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"data.created_at é uma data válida\", function () {",
              "    pm.expect(jsonData.data.created_at).to.be.a('string').and.to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Content-Type é application/json\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
